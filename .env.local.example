# Secret (server-only, NEVER expose to browser) — used by /api/observations
# Grab this from Supabase dashboard: Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret devices must send to authenticate to the ingestion API
DEVICE_INGEST_API_KEY=

# Keepa API key — used to look up Amazon prices/fees by UPC (Amazon data sync).
# This is a real, billed secret tied to your Keepa subscription — never hardcode
# it into source, unlike the anon key above. Get one at https://keepa.com/#!api
KEEPA_API_KEY=

# Anthropic API key — powers the Arbiter chat assistant. A real, billed secret,
# never hardcode it. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
